{
  "name": "pokegrid",
  "version": "1.5.4",
  "description": "Rode 4 contas de Poke Idle World ao mesmo tempo, em uma janela so / Run 4 Poke Idle World accounts at once, in a single window",
  "main": "main.js",
  "author": "soufoka",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win --x64"
  },
  "keywords": [
    "electron",
    "multi-account",
    "poke-idle-world",
    "idle-game"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "online.idleworld.pokegrid",
    "productName": "PokeGrid",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "presets/**/*",
      "tray.png",
      "!node_modules/electron-builder/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  }
}
