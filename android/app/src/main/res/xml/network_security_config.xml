<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS-only, system+user CA trust: no cleartext, no custom pinning (the game's own TLS cert
     rotates outside our control). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
